# Copy to .env and fill in. Never commit .env.

# Gemini API key (planning, images, Lyria music)
GEMINI_API_KEY=

# YouTube publishing: Google Cloud > APIs & Services > Credentials > OAuth client ID,
# application type "Desktop app"; enable "YouTube Data API v3".
# Videos uploaded by an unaudited API project are forced to Private by YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok publishing: developers.tiktok.com > your app with Login Kit + Content Posting API
# (Direct Post), platform "Desktop". Register this exact redirect URI:
#   http://127.0.0.1:4173/oauth/tiktok/callback/
# Posts from an unaudited client are forced to Private (SELF_ONLY) by TikTok.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
